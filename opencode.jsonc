{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-wakatime"],
  "autoupdate": false,
  "mcp": {
    "notion": {
      "url": "https://mcp.notion.com/mcp",
      "type": "remote"
    },
    "helium-browser": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "helium-devtools-mcp@1.1.1-helium.1",
        "--autoConnect"
      ]
    }
  }
}

